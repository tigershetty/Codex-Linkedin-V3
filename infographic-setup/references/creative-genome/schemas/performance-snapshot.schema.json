{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shettysdesk.com/schemas/creative-genome/performance-snapshot.schema.json",
  "title": "Creative Bundle Performance Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_id",
    "channel",
    "checkpoint",
    "captured_at",
    "creative_bundle_id",
    "genome_reference_ids",
    "creative_element_ids",
    "element_transfer",
    "content_mode",
    "claim_mode",
    "artifact_type",
    "creative_execution",
    "metrics",
    "audience_relevance_sample",
    "transfer_result",
    "next_adaptation",
    "notes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.1.0" },
    "content_id": { "type": "string" },
    "channel": { "enum": ["linkedin", "substack", "website"] },
    "checkpoint": { "enum": ["24h", "day7", "day28"] },
    "captured_at": { "type": ["string", "null"] },
    "creative_bundle_id": { "type": "string" },
    "genome_reference_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(LI-|TEXT-)" },
      "uniqueItems": true
    },
    "creative_element_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "element_transfer": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["creative_element_id", "transfer_result", "note"],
        "properties": {
          "creative_element_id": { "type": "string", "pattern": "^CE-" },
          "transfer_result": { "enum": ["pending", "transferred", "unclear", "did_not_transfer"] },
          "note": { "type": "string" }
        }
      }
    },
    "content_mode": { "type": "string" },
    "claim_mode": { "type": "string" },
    "artifact_type": { "type": ["string", "null"] },
    "creative_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_family",
        "spatial_thesis",
        "reading_contract",
        "density_plan",
        "motion_treatment",
        "creative_atoms",
        "source_capture_provenance"
      ],
      "properties": {
        "visual_family": { "type": "string" },
        "spatial_thesis": { "type": "string" },
        "reading_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["glance_3s", "orientation_10s", "deep_use"],
          "properties": {
            "glance_3s": { "type": "string" },
            "orientation_10s": { "type": "string" },
            "deep_use": { "type": "string" }
          }
        },
        "density_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["macro_regions", "micro_units", "reason_for_density"],
          "properties": {
            "macro_regions": { "type": "integer", "minimum": 1 },
            "micro_units": { "type": "integer", "minimum": 0 },
            "reason_for_density": { "type": "string" }
          }
        },
        "motion_treatment": { "type": "string" },
        "creative_atoms": { "type": "array", "items": { "type": "string" } },
        "source_capture_provenance": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": ["number", "null"] }
    },
    "audience_relevance_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sample_size", "relevant_count", "observations"],
      "properties": {
        "status": { "enum": ["not_needed", "pending", "captured"] },
        "sample_size": { "type": ["integer", "null"], "minimum": 0 },
        "relevant_count": { "type": ["integer", "null"], "minimum": 0 },
        "observations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "transfer_result": { "enum": ["pending", "transferred", "unclear", "did_not_transfer"] },
    "next_adaptation": { "type": "string" },
    "notes": { "type": "string" }
  }
}
