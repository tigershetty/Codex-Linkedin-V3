{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shettysdesk.com/schemas/creative-genome/supply-chain-knowledge-map.schema.json",
  "title": "Supply-Chain Knowledge Map",
  "description": "A small, source-linked graph for narrowing an already broad supply-chain area into an explicit scope window. It is not a topic taxonomy, content calendar, claim-evidence record, or publication approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "map_id", "status", "title", "source_registry", "nodes", "edges", "branches"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "map_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "active", "archived"] },
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string" },
    "source_registry": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "branches": { "type": "array", "items": { "$ref": "#/$defs/branch" } },
    "notes": { "type": "string" }
  },
  "$defs": {
    "recordStatus": { "enum": ["navigation_only", "candidate_ready", "corroborated"] },
    "evidenceStatus": { "enum": ["research_seed", "source_backed"] },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "basis", "citation", "claim_boundary", "status"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "basis": { "enum": ["source_link", "documented_method"] },
        "citation": { "type": "string", "minLength": 1 },
        "locator": { "type": "string" },
        "source_capsule": { "$ref": "#/$defs/sourceCapsule" },
        "claim_boundary": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "superseded", "unavailable"] },
        "last_reviewed": { "type": "string" }
      }
    },
    "sourceCapsule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_locator", "accessed_on", "supported_paraphrase", "evidence_note_path"],
      "properties": {
        "source_locator": { "type": "string", "minLength": 1 },
        "accessed_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "supported_paraphrase": { "type": "string", "minLength": 1 },
        "evidence_note_path": { "type": "string", "minLength": 1 }
      }
    },
    "readerContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "moment"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "moment": { "type": "string", "minLength": 1 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "label", "kind", "evidence_status", "status", "source_refs", "claim_boundary"],
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["function", "role", "work_object", "decision", "tension", "method", "metric", "system", "event"] },
        "aliases": { "$ref": "#/$defs/stringArray" },
        "reader_contexts": { "type": "array", "items": { "$ref": "#/$defs/readerContext" } },
        "work_artifacts": { "$ref": "#/$defs/stringArray" },
        "decision_questions": { "$ref": "#/$defs/stringArray" },
        "boundaries_and_exceptions": { "$ref": "#/$defs/stringArray" },
        "cognitive_jobs": {
          "type": "array",
          "items": { "enum": ["recognise", "orient", "choose", "explain", "diagnose", "prepare", "compare"] },
          "uniqueItems": true
        },
        "truth_routes": {
          "type": "array",
          "items": { "enum": ["framework", "operating_method", "evidence_display", "case_or_event", "hypothesis_or_simulation", "tiger_judgment", "opinion_or_synthesis"] },
          "uniqueItems": true
        },
        "evidence_routes": { "$ref": "#/$defs/stringArray" },
        "creative_retrieval_tags": { "$ref": "#/$defs/stringArray" },
        "not_a_claim": { "type": "string" },
        "evidence_status": { "$ref": "#/$defs/evidenceStatus" },
        "status": { "$ref": "#/$defs/recordStatus" },
        "source_refs": { "$ref": "#/$defs/stringArray" },
        "claim_boundary": { "type": "string", "minLength": 1 },
        "last_reviewed": { "type": "string" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "from_id", "relation", "to_id", "basis", "evidence_status", "status", "source_refs", "claim_boundary"],
      "properties": {
        "edge_id": { "type": "string", "minLength": 1 },
        "from_id": { "type": "string", "minLength": 1 },
        "relation": { "enum": ["constrains", "feeds", "hands_off_to", "measures", "trades_off_with", "validates", "owns", "requires"] },
        "to_id": { "type": "string", "minLength": 1 },
        "basis": { "enum": ["source_link", "documented_method", "hypothesis"] },
        "evidence_status": { "$ref": "#/$defs/evidenceStatus" },
        "status": { "$ref": "#/$defs/recordStatus" },
        "source_refs": { "$ref": "#/$defs/stringArray" },
        "claim_boundary": { "type": "string", "minLength": 1 },
        "last_reviewed": { "type": "string" }
      }
    },
    "scopeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reader_role", "reader_moment", "operating_object_or_signal", "decision_or_tension", "cognitive_job", "truth_route", "reader_payoff", "in_scope", "out_of_scope", "relation_to_show", "boundary_or_exception"],
      "properties": {
        "reader_role": { "type": "string", "minLength": 1 },
        "reader_moment": { "type": "string", "minLength": 1 },
        "operating_object_or_signal": { "type": "string", "minLength": 1 },
        "decision_or_tension": { "type": "string", "minLength": 1 },
        "cognitive_job": { "enum": ["recognise", "orient", "choose", "explain", "diagnose", "prepare", "compare"] },
        "truth_route": { "enum": ["framework", "operating_method", "evidence_display", "case_or_event", "hypothesis_or_simulation", "tiger_judgment", "opinion_or_synthesis"] },
        "reader_payoff": { "type": "string", "minLength": 1 },
        "in_scope": { "type": "string", "minLength": 1 },
        "out_of_scope": { "type": "string", "minLength": 1 },
        "relation_to_show": { "enum": ["conditional_decision", "sequence", "hierarchy", "trade_off", "comparison", "network", "lookup"] },
        "boundary_or_exception": { "type": "string", "minLength": 1 }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "purpose", "node_ids", "edge_ids"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "node_ids": { "$ref": "#/$defs/stringArray" },
        "edge_ids": { "$ref": "#/$defs/stringArray" }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch_id", "label", "primary_node_id", "node_ids", "edge_ids", "scope_window", "creative_retrieval_tags", "views", "evidence_status", "status", "source_refs", "claim_boundary"],
      "properties": {
        "branch_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "primary_node_id": { "type": "string", "minLength": 1 },
        "node_ids": { "$ref": "#/$defs/stringArray" },
        "edge_ids": { "$ref": "#/$defs/stringArray" },
        "scope_window": { "$ref": "#/$defs/scopeWindow" },
        "creative_retrieval_tags": { "$ref": "#/$defs/stringArray" },
        "views": {
          "type": "object",
          "additionalProperties": false,
          "required": ["narrow", "deep", "wide"],
          "properties": {
            "narrow": { "$ref": "#/$defs/view" },
            "deep": { "$ref": "#/$defs/view" },
            "wide": { "$ref": "#/$defs/view" }
          }
        },
        "evidence_status": { "$ref": "#/$defs/evidenceStatus" },
        "status": { "$ref": "#/$defs/recordStatus" },
        "source_refs": { "$ref": "#/$defs/stringArray" },
        "claim_boundary": { "type": "string", "minLength": 1 },
        "last_reviewed": { "type": "string" }
      }
    }
  }
}
