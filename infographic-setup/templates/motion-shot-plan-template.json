{
  "project": "{slug}-motion",
  "version": 2,
  "category": "{decision-board|process|matrix|table|formula|comparison|hierarchy|network|annotated-hero|calendar|operating-system}",
  "durationSeconds": 12,
  "source": "assets/visual.png",
  "sourceDimensions": {
    "width": 0,
    "height": 0
  },
  "promise": "Motion adds value beyond the still by showing {sequence, dependency, comparison, state change, or decision logic}.",
  "lockedElements": [
    "headline",
    "body text",
    "logos",
    "panel geometry",
    "background scene"
  ],
  "loop": {
    "firstFrame": "complete selected 1080 x 1350 visual",
    "reset": "clean authored stage or source-locked focus transition",
    "build": "source-authored components or deterministic value layers move in the visual's reading order",
    "finalFrame": "complete selected 1080 x 1350 visual"
  },
  "components": [
    {
      "id": "unit-01",
      "box": [0, 0, 0, 0],
      "method": "shaped-source-component|deterministic-vector-data-layer|whole-compound-component|fitted-plate",
      "motion": "assemble|route|compare|resolve",
      "communicationJob": "{what this unit teaches}"
    }
  ],
  "beats": [
    {
      "time": "0.00-0.30",
      "focus": "complete visual hold"
    },
    {
      "time": "0.30-0.65",
      "focus": "clean reset or source-locked focus transition"
    },
    {
      "time": "0.65-1.40",
      "focus": "unit-01 reveal"
    },
    {
      "time": "6.40-8.00",
      "focus": "complete visual hold and clean loop"
    }
  ],
  "qa": {
    "firstFramePixelDiff": 0,
    "restoredFramePixelDiff": 0,
    "finalFramePixelDiff": 0,
    "inspectResetAtSourceResolution": true,
    "inspectRepresentativeContactSheet": true,
    "inspectEncodedGif": true,
    "exportGifAndMp4": true
  }
}
